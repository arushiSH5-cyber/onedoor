# Local: SQLite file. Production: a Postgres URL (e.g. Neon), which switches Prisma to postgresql.
DATABASE_URL="file:./dev.db"
# Optional: enables free-text parsing and live translation. The app works without it.
ANTHROPIC_API_KEY=
# Optional: real SMS via Twilio. Without these, use the in-app simulator at /sms.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: protects the dashboard CSV export in production (leave blank for open access).
DASHBOARD_TOKEN=
